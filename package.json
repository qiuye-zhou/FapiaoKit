{
  "name": "FapiaoKit",
  "version": "1.0.0",
  "description": "基于 Electron 的差旅发票整理工具：自动解析 PDF 发票、识别类型与金额、批量重命名并生成 Excel 报销单",
  "main": "out/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:web": "vue-tsc && vite build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "electron:dev": "concurrently \"npm run build:web && npm run build:electron && npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build:win": "npm run build:web && npm run build:electron && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --publish=never",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix ."
  },
  "keywords": [
    "electron",
    "vue3",
    "vite",
    "desktop",
    "app",
    "fapiao",
    "kit"
  ],
  "author": "秋叶ゞ",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.8",
    "wait-on": "^9.0.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^3.11.174",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "pnpm": {
    "overrides": {
      "canvas": "-"
    }
  }
}